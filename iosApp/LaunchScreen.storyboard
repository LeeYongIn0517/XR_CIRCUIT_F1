                                <rect key="frame" x="86" y="322" width="240" height="240"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="240" id="brand-width"/>
                                    <constraint firstAttribute="height" constant="240" id="brand-height"/>
                                </constraints>
